<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/header_root"
    android:layout_width="match_parent"
    android:layout_height="86dp"
    android:background="@drawable/bg_header_gradient"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <ImageButton
        android:id="@+id/btn_header_back"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="start|center_vertical"
        android:background="@drawable/bg_round_white_translucent"
        android:contentDescription="@string/back"
        android:padding="9dp"
        android:src="@drawable/ic_back"
        android:visibility="gone"
        app:tint="@color/white" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="标题"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_header_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="#D9DEFF"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_header_action"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="end|center_vertical"
        android:background="@drawable/bg_round_white_translucent"
        android:contentDescription="操作"
        android:padding="9dp"
        android:src="@drawable/ic_history_gen"
        android:visibility="gone"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/tv_header_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:background="?attr/selectableItemBackground"
        android:padding="10dp"
        android:text="清空"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:visibility="gone" />

</FrameLayout>
