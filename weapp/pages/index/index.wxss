.hero {
  background: linear-gradient(135deg, #5B6CF9 0%, #7B61FF 100%);
  border-radius: 28rpx;
  padding: 40rpx 32rpx 32rpx;
  margin-bottom: 24rpx;
  color: #FFFFFF;
}

.hero-title {
  font-size: 46rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.hero-sub {
  font-size: 26rpx;
  opacity: 0.86;
  margin-top: 8rpx;
}

.hero-tags {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
}

.hero-tags .tag {
  background: rgba(255, 255, 255, 0.18);
  color: #FFFFFF;
  margin-right: 12rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.tile {
  width: 48.5%;
  background: var(--surface);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 20rpx rgba(31, 36, 48, 0.04);
}

.tile-badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.tile-title {
  font-size: 29rpx;
  font-weight: 600;
}

.tile-sub {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.link {
  font-size: 24rpx;
  color: var(--brand);
}

.rec {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--divider);
}

.rec-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.rec-value {
  font-size: 27rpx;
  color: var(--text);
}

.rec-meta {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 2rpx;
}

.notice {
  background: var(--surface-alt);
  box-shadow: none;
}

.notice-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-2);
  margin-bottom: 8rpx;
}

.notice-text {
  font-size: 23rpx;
  color: var(--text-3);
  line-height: 1.7;
}
