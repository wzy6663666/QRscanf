<view class="page">
  <view class="pill-group" style="margin-bottom:24rpx">
    <view class="pill {{tab === 'scan' ? 'pill-active' : ''}}" data-tab="scan" bindtap="switchTab">扫码记录</view>
    <view class="pill {{tab === 'gen' ? 'pill-active' : ''}}" data-tab="gen" bindtap="switchTab">生成记录</view>
  </view>

  <block wx:if="{{tab === 'scan'}}">
    <view class="card" wx:if="{{scanList.length}}">
      <view class="row-between" style="margin-bottom:8rpx">
        <text class="title">共 {{scanList.length}} 条</text>
        <text class="danger" bindtap="clearScan">清空</text>
      </view>
      <view class="item" wx:for="{{scanList}}" wx:key="id" bindtap="openScan" data-index="{{index}}">
        <view class="dot" style="background:{{item.color}}"></view>
        <view class="grow">
          <view class="value wrap-2">{{item.value}}</view>
          <view class="meta">{{item.formatLabel}} · {{item.type}} · {{item.timeText}}</view>
        </view>
        <text class="action" catchtap="copyScan" data-index="{{index}}">复制</text>
      </view>
    </view>
    <view class="card empty" wx:else>还没有扫码记录</view>
  </block>

  <block wx:else>
    <view class="card" wx:if="{{genList.length}}">
      <view class="row-between" style="margin-bottom:8rpx">
        <text class="title">共 {{genList.length}} 条</text>
        <text class="danger" bindtap="clearGen">清空</text>
      </view>
      <view class="item" wx:for="{{genList}}" wx:key="id" bindtap="openGen" data-index="{{index}}">
        <view class="dot" style="background:{{item.color}}"></view>
        <view class="grow">
          <view class="value wrap-2">{{item.content}}</view>
          <view class="meta">{{item.formatLabel}} · {{item.detail}} · {{item.timeText}}</view>
        </view>
        <text class="action" catchtap="removeGen" data-index="{{index}}">删除</text>
      </view>
      <view class="hint">点任一条可以把内容和参数重新带回生成页</view>
    </view>
    <view class="card empty" wx:else>还没有生成记录，去生成页保存一张就会出现在这里</view>
  </block>
</view>
