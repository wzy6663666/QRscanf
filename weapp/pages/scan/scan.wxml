<view class="page">
  <view class="pill-group" style="margin-bottom:24rpx">
    <view class="pill {{mode === 'single' ? 'pill-active' : ''}}" bindtap="switchMode" data-mode="single">单次扫码</view>
    <view class="pill {{mode === 'continuous' ? 'pill-active' : ''}}" bindtap="switchMode" data-mode="continuous">连续扫码</view>
  </view>

  <view class="scan-card">
    <view class="scan-hint">{{mode === 'single' ? '识别成功后会立即显示结果' : '连续识别多个码，自动按「码制 + 内容」去重'}}</view>
    <view class="scan-btn" bindtap="startScan">
      <view class="scan-frame"></view>
      <view class="scan-main">{{scanning ? '识别中…' : '开始扫码'}}</view>
      <view class="scan-sub">调用微信扫码，支持 13 种码制</view>
    </view>
    <view class="scan-actions">
      <text class="minor-link" bindtap="pickImage">从相册识别</text>
      <text class="minor-link" bindtap="clearAll" wx:if="{{results.length}}">清空结果</text>
    </view>
  </view>

  <block wx:if="{{mode === 'single'}}">
    <view class="card" wx:if="{{current}}">
      <view class="row-between">
        <view class="row">
          <view class="dot" style="background:{{current.color}}"></view>
          <text class="fmt">{{current.formatLabel}}</text>
          <text class="tag" style="margin-left:12rpx">{{current.type}}</text>
        </view>
        <text class="muted">{{current.timeText}}</text>
      </view>
      <view class="value mono">{{current.value}}</view>
      <view class="row" style="margin-top:8rpx">
        <text class="muted">字符数 {{current.length}}</text>
      </view>
      <view class="divider"></view>
      <view class="row">
        <button class="btn btn-ghost btn-sm grow" bindtap="copyCurrent">复制内容</button>
        <view style="width:16rpx"></view>
        <button class="btn btn-sm grow" bindtap="openDetail">详情</button>
        <view style="width:16rpx"></view>
        <button class="btn btn-sm grow" bindtap="cloneCurrent" wx:if="{{current.canClone}}">复刻</button>
      </view>
    </view>
    <view class="card empty" wx:else>还没有识别结果</view>
  </block>

  <block wx:else>
    <view class="card" wx:if="{{results.length}}">
      <view class="row-between">
        <text class="title">已识别 {{results.length}} 个</text>
        <text class="muted" wx:if="{{dropped}}">去重 {{dropped}} 个</text>
      </view>
      <view class="list-item" wx:for="{{results}}" wx:key="key">
        <view class="idx">{{index + 1}}</view>
        <view class="grow">
          <view class="item-value wrap-2">{{item.value}}</view>
          <view class="item-meta">
            <text class="dot" style="background:{{item.color}}"></text>
            <text>{{item.formatLabel}} · {{item.type}} · {{item.timeText}}</text>
            <text class="dup" wx:if="{{item.duplicated}}">重复</text>
          </view>
        </view>
        <text class="del" catchtap="removeOne" data-index="{{index}}">删除</text>
      </view>
      <view class="divider"></view>
      <view class="row">
        <button class="btn btn-ghost btn-sm grow" bindtap="copyAll">复制全部</button>
        <view style="width:16rpx"></view>
        <button class="btn btn-sm grow" bindtap="saveAllToRecords">查看记录</button>
      </view>
    </view>
    <view class="card empty" wx:else>{{autoTip}}</view>
  </block>
</view>
