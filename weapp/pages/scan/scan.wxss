.scan-card {
  background: var(--surface);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 36, 48, 0.04);
}

.scan-hint {
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 20rpx;
}

.scan-btn {
  border-radius: 24rpx;
  background: linear-gradient(135deg, #5B6CF9 0%, #7B61FF 100%);
  padding: 40rpx 0 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #FFFFFF;
}

.scan-frame {
  width: 96rpx;
  height: 96rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.scan-main {
  font-size: 34rpx;
  font-weight: 600;
}

.scan-sub {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 6rpx;
}

.scan-actions {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
}

.minor-link {
  font-size: 25rpx;
  color: var(--brand);
  padding: 8rpx 24rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
  display: inline-block;
}

.fmt {
  font-size: 26rpx;
  font-weight: 600;
}

.value {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.65;
  word-break: break-all;
  color: var(--text);
}

.list-item {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-top: 1rpx solid var(--divider);
}

.idx {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: var(--surface-alt);
  color: var(--text-3);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.item-value {
  font-size: 27rpx;
  word-break: break-all;
  color: var(--text);
}

.item-meta {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

.dup {
  margin-left: 12rpx;
  color: var(--orange);
}

.del {
  font-size: 23rpx;
  color: var(--text-3);
  padding: 8rpx 0 8rpx 20rpx;
  flex-shrink: 0;
}
