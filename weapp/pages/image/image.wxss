.hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.7;
}

.item {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-top: 1rpx solid var(--divider);
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  margin: 14rpx 16rpx 0 0;
  flex-shrink: 0;
}

.value {
  font-size: 27rpx;
  word-break: break-all;
}

.meta {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

.action {
  font-size: 24rpx;
  color: var(--brand);
  padding: 8rpx 0 8rpx 20rpx;
}
