.switch-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.switch-row.last {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.s-title {
  font-size: 28rpx;
  color: var(--text);
}

.s-sub {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.danger {
  font-size: 28rpx;
  color: var(--red);
}

.about-line {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.about-line.last {
  border-bottom: none;
}

.k {
  width: 200rpx;
  font-size: 25rpx;
  color: var(--text-2);
  flex-shrink: 0;
}

.v {
  flex: 1;
  font-size: 25rpx;
  color: var(--text);
  line-height: 1.6;
}

.foot {
  padding: 8rpx 8rpx 40rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.7;
  text-align: center;
}
