.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.k {
  font-size: 26rpx;
  color: var(--text-2);
}

.v {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
}

.colors {
  display: flex;
  margin-top: 20rpx;
}

.color-cell {
  display: flex;
  align-items: center;
  margin-right: 32rpx;
}

.color-chip {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  border: 2rpx solid rgba(31, 36, 48, 0.12);
  margin-right: 10rpx;
}

.color-text {
  font-size: 23rpx;
  color: var(--text-2);
}

.hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.7;
}

.compare {
  display: flex;
  margin-top: 16rpx;
}

.compare-cell {
  flex: 1;
  height: 300rpx;
  border-radius: 16rpx;
  background: var(--surface-alt);
  margin: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.compare-img {
  width: 100%;
  height: 100%;
}

.compare-canvas {
  width: 280rpx;
  height: 280rpx;
}

.compare-tip {
  position: absolute;
  font-size: 22rpx;
  color: var(--text-3);
}

.ph {
  color: #B6BCC8;
}

.work-canvas {
  position: fixed;
  left: -2000rpx;
  top: 0;
  width: 4rpx;
  height: 4rpx;
}
